---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Modal from '../components/Modal.astro';
import Starfield from '../components/Starfield.astro';
import BetaBanner from '../components/BetaBanner.astro';

interface Props {
  title: string;
  description?: string;
  activeRoute?: 'index' | 'clubs' | 'for-clubs' | 'about';
  ogImage?: string;
  /**
   * When set, emits a `<link rel="preload" as="image" fetchpriority="high">` in <head>
   * so the browser fetches this image early — useful when the page's LCP is a known
   * hero image. Pass the same URL (or shape) the page renders. Leave undefined when
   * the LCP is text or unknown.
   */
  lcpImage?: string;
}

const {
  title,
  description = 'respawn.kz — онлайн-бронирование компьютерных клубов в Казахстане. Найди клуб, забронируй слот, оплати картой.',
  activeRoute,
  ogImage = '/img/club-hero.webp',
  lcpImage,
} = Astro.props;

const ogImageAbs = new URL(ogImage, Astro.site ?? 'https://respawn.kz').toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://respawn.kz').toString();
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph / Telegram / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="respawn.kz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:locale" content="ru_KZ" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <meta name="theme-color" content="#0a0a0f" />

    {lcpImage && <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />}

    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font load: preload triggers early fetch; onload swaps rel to stylesheet.
         noscript fallback ensures fonts load when JS is disabled. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>
  </head>
  <body>
    <Starfield />
    <BetaBanner />
    <a href="#main-content" class="skip-link">Перейти к контенту</a>
    <noscript>
      <div class="noscript-banner" role="alert">
        Для бронирования и личного кабинета требуется включить JavaScript.
      </div>
    </noscript>
    <Header activeRoute={activeRoute} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Modal />
    <script>
      import '../scripts/init';
    </script>
    <!-- 2026-05-23: SW disabled for beta period to prevent stale-cache bugs.
         During rapid iteration (auth flow, booking UX, etc) cached old code
         was confusing users. registerSW() commented out so no new SW
         installs. Cleanup script below unregisters any existing SW from
         previous deploys + clears caches, forcing a single reload to fresh
         code. Re-enable when codebase stabilizes. -->
    <script is:inline>
      (async () => {
        if (!('serviceWorker' in navigator)) return;
        try {
          const regs = await navigator.serviceWorker.getRegistrations();
          if (regs.length === 0) return; // no SW, nothing to clean
          for (const r of regs) await r.unregister();
          if ('caches' in window) {
            const keys = await caches.keys();
            await Promise.all(keys.map((k) => caches.delete(k)));
          }
          // Reload ONCE per session so cleared-cache content is fetched fresh.
          // sessionStorage guard prevents an infinite reload loop if something
          // about this script keeps detecting SW (shouldn't, but defensive).
          if (!sessionStorage.getItem('sw-killed')) {
            sessionStorage.setItem('sw-killed', '1');
            window.location.reload();
          }
        } catch (e) {
          console.warn('[respawn.kz] SW cleanup error', e);
        }
      })();
    </script>
  </body>
</html>
