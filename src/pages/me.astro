---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Личный кабинет — respawn.kz">
  <section class="me-page" id="me-root">
    <div class="container">
      <header class="me-page__header">
        <h1 class="me-page__title">Мои брони</h1>
        <p class="me-page__email">Аккаунт: <strong id="me-email"></strong></p>
        <div class="demo-banner" id="me-demo-banner" hidden style="margin-top:16px;max-width:600px">
          ⚙️ <strong>Demo-режим</strong>: брони сохранены локально в этом браузере. При очистке cookies/localStorage они пропадут.
        </div>
      </header>

      <aside class="loyalty-card" id="loyalty-card" hidden aria-labelledby="loyalty-card-title">
        <div class="loyalty-card__icon" aria-hidden="true">🎁</div>
        <div class="loyalty-card__body">
          <div class="loyalty-card__title" id="loyalty-card-title">
            Бонусные часы: <strong id="loyalty-balance">0.00</strong>
          </div>
          <div class="loyalty-card__meta" id="loyalty-meta">
            Заработано всего: <span id="loyalty-earned">0</span> ч
          </div>
          <div class="loyalty-card__hint">
            5% часов возвращается бонусами после каждой завершённой брони.
          </div>
        </div>
      </aside>

      <div class="me-loading" id="me-loading" aria-live="polite" aria-busy="true">
        <p style="text-align:center;color:var(--text-muted)">Загружаем брони…</p>
      </div>

      <div class="me-error" id="me-error" role="alert" hidden style="text-align:center;padding:40px 20px;color:var(--text-muted)">
        <p>Не удалось загрузить брони.</p>
        <button type="button" class="btn btn--ghost btn--sm" style="margin-top:12px" onclick="location.reload()">Обновить страницу</button>
      </div>

      <ul class="me-bookings__list" id="me-bookings" hidden></ul>

      <div class="me-empty" id="me-empty" hidden>
        <p>У тебя пока нет броней.</p>
        <a href="/clubs/" class="btn btn--primary" style="margin-top:16px">К каталогу клубов</a>
      </div>
    </div>
  </section>
</BaseLayout>
