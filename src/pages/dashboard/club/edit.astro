---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DashboardNav from '../../../components/DashboardNav.astro';
import { CITIES } from '../../../data/cities';
---

<BaseLayout title="Редактировать клуб — Кабинет — respawn.kz">
  <section class="dashboard-page" id="club-edit-root">
    <div class="container">
      <header class="dashboard-page__header">
        <h1 class="dashboard-page__title">Редактировать клуб</h1>
      </header>

      <DashboardNav variant="dashboard" />

      <div class="dashboard-loading" id="club-edit-loading">
        <p style="text-align:center;color:var(--text-muted)">Загружаем…</p>
      </div>

      <div class="club-edit-error" id="club-edit-error" hidden style="padding:24px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:12px;color:rgb(248,113,113)"></div>

      <form id="club-edit-form" class="dashboard-form" hidden>
        <fieldset class="dashboard-fieldset">
          <legend class="dashboard-fieldset__legend">Основное</legend>

          <label class="auth-field" for="club-name">
            <span class="auth-label">Название *</span>
            <input type="text" id="club-name" name="name" class="auth-input" required maxlength="120"
                   aria-describedby="club-edit-save-error" aria-invalid="false" />
          </label>

          <div class="dashboard-form__row">
            <label class="auth-field" for="club-city">
              <span class="auth-label">Город *</span>
              <select id="club-city" name="city" class="auth-input" required
                      aria-describedby="club-edit-save-error" aria-invalid="false">
                {CITIES.map((c) => <option value={c.id}>{c.label}</option>)}
              </select>
            </label>
            <label class="auth-field" for="club-district">
              <span class="auth-label">Район</span>
              <input type="text" id="club-district" name="district" class="auth-input" maxlength="120" />
            </label>
          </div>

          <label class="auth-field" for="club-address">
            <span class="auth-label">Адрес *</span>
            <input type="text" id="club-address" name="address" class="auth-input" required maxlength="200"
                   aria-describedby="club-edit-save-error" aria-invalid="false" />
          </label>
        </fieldset>

        <fieldset class="dashboard-fieldset">
          <legend class="dashboard-fieldset__legend">Контакты и цены</legend>

          <div class="dashboard-form__row">
            <label class="auth-field" for="club-phone">
              <span class="auth-label">Телефон</span>
              <input type="tel" id="club-phone" name="phone" class="auth-input" maxlength="40" />
            </label>
            <label class="auth-field" for="club-price-per-hour">
              <span class="auth-label">Цена за час, ₸ *</span>
              <input type="number" id="club-price-per-hour" name="price_per_hour" class="auth-input" required min="100" max="50000" step="100"
                     aria-describedby="club-edit-save-error" aria-invalid="false" />
            </label>
          </div>

          <label class="auth-field" for="club-description">
            <span class="auth-label">Описание</span>
            <textarea id="club-description" name="description" class="auth-input" rows="4" maxlength="1000"></textarea>
          </label>
        </fieldset>

        <fieldset class="dashboard-fieldset">
          <legend class="dashboard-fieldset__legend">Часы работы</legend>
          <p style="color:var(--text-secondary);font-size:14px">Можно задать одинаковые часы для всех дней через кнопку ниже.</p>

          <div class="time-picker" id="time-picker">
            <!-- 7 day rows generated by script -->
          </div>

          <button type="button" class="btn btn--ghost btn--sm" id="copy-mon-to-all" style="align-self:flex-start">Скопировать пн на все дни</button>
        </fieldset>

        <fieldset class="dashboard-fieldset">
          <legend class="dashboard-fieldset__legend">Каталог</legend>

          <div class="auth-field">
            <span class="auth-label" id="tags-label">Тэги (что есть в клубе)</span>
            <div class="filter__tags" id="tags-checkboxes" role="group" aria-labelledby="tags-label">
              <label class="tag-check"><input type="checkbox" name="tag" value="PC" /><span>PC</span></label>
              <label class="tag-check"><input type="checkbox" name="tag" value="PS5" /><span>PS5</span></label>
              <label class="tag-check"><input type="checkbox" name="tag" value="VR" /><span>VR</span></label>
              <label class="tag-check"><input type="checkbox" name="tag" value="Sim Racing" /><span>Sim Racing</span></label>
            </div>
          </div>

          <label class="auth-field" for="club-equipment">
            <span class="auth-label">Оборудование (по строчке)</span>
            <textarea id="club-equipment" name="equipment" class="auth-input" rows="5" placeholder="RTX 4080 / i7-13700K&#10;Мониторы 240Hz&#10;Razer DeathAdder V3"></textarea>
          </label>
        </fieldset>

        <fieldset class="dashboard-fieldset">
          <legend class="dashboard-fieldset__legend">Фото</legend>
          <p style="color:var(--text-secondary);font-size:14px">
            Загрузи прямо файлы (JPEG / PNG / WebP, до 3 МБ) или вставь ссылки на внешние фото. До 6 шт.
          </p>

          <div class="photos-uploader" id="photos-uploader">
            <input type="file" id="photo-file-input" accept="image/jpeg,image/png,image/webp" multiple hidden aria-label="Выбрать файлы фотографий" />
            <button type="button" class="btn btn--primary btn--sm" id="photo-pick-btn">+ Выбрать файлы</button>
            <button type="button" class="btn btn--ghost btn--sm" id="add-photo-url">+ Внешняя ссылка</button>
            <span style="color:var(--text-muted);font-size:14px;margin-left:8px">или перетащи фото сюда</span>
          </div>

          <div id="photos-list" class="photos-list"></div>
        </fieldset>

        <fieldset class="dashboard-fieldset">
          <legend class="dashboard-fieldset__legend">Оформление</legend>

          <label class="auth-field" for="club-gradient">
            <span class="auth-label">Градиент (CSS, fallback когда нет фото)</span>
            <input type="text" id="club-gradient" name="gradient" class="auth-input"
                   placeholder="linear-gradient(135deg, #8b5cf6, #ec4899)" />
          </label>
        </fieldset>

        <!-- Publication toggle — visible only to super-admin (set by JS) -->
        <div id="publish-section" hidden>
          <fieldset class="dashboard-fieldset">
            <legend class="dashboard-fieldset__legend">Публикация</legend>
            <label style="display:flex;align-items:center;gap:12px">
              <input type="checkbox" name="is_published" />
              <span>Опубликован (виден в каталоге)</span>
            </label>
          </fieldset>
        </div>

        <div class="auth-error" id="club-edit-save-error" aria-live="polite" hidden></div>
        <div class="auth-success" id="club-edit-save-success" aria-live="polite" role="status" hidden></div>

        <button type="submit" class="btn btn--primary btn--large dashboard-form__submit">
          Сохранить
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
