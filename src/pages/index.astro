---
import '../styles/respawn-v4.css';
import { loadAllClubs } from '../lib/clubs-loader';
import { LANDING_FAQ } from '../data/content';
import { CITIES } from '../data/cities';
import BetaBanner from '../components/BetaBanner.astro';

const allClubs = await loadAllClubs();
// Show ALL clubs on the homepage (user request 2026-05-20: «давай сразу
// список всех клубов»). Catalog page /clubs/ has filters/search.
const topClubs = allClubs;

const steps = [
  {
    num: '01',
    title: 'Выбери клуб',
    desc: 'Фильтруй по району, цене и оборудованию. Сравнивай рейтинги и отзывы.',
    icon: `<svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M28 6 C20 6 14 12 14 20 C14 30 28 48 28 48 C28 48 42 30 42 20 C42 12 36 6 28 6 Z"/><circle cx="28" cy="20" r="5"/></svg>`,
  },
  {
    num: '02',
    title: 'Забронируй слот',
    desc: 'Выбери дату, время и количество часов. Оплачивай картой — Visa, Mastercard, Kaspi.',
    icon: `<svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="12" width="40" height="38" rx="4"/><path d="M8 22 H48"/><path d="M19 6 V18 M37 6 V18"/><path d="M19 32 H27 M19 40 H37"/></svg>`,
  },
  {
    num: '03',
    title: 'Приходи и играй',
    desc: 'Покажи QR-код на ресепшене — твоё место уже готово. Без очередей и звонков.',
    icon: `<svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="20" width="44" height="26" rx="13"/><circle cx="18" cy="33" r="2.5" fill="currentColor" stroke="none"/><circle cx="40" cy="29" r="2" fill="currentColor" stroke="none"/><circle cx="44" cy="37" r="2" fill="currentColor" stroke="none"/><path d="M14 27 V39 M10 33 H18"/></svg>`,
  },
];

const playerBenefits = [
  { title: 'Сравнение клубов', desc: 'Цены, оборудование, рейтинги и отзывы — на одной странице. Без звонков по каждому клубу.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="22" height="22" rx="3"/><path d="M3 11 H25 M11 3 V25"/></svg>` },
  { title: 'Бронь за 30 секунд', desc: 'Выбери дату, время, количество часов — и оплати картой. Слот закреплён за тобой.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="22" height="20" rx="3"/><path d="M3 11 H25"/><path d="M9 2 V8 M19 2 V8"/><path d="M9 17 L13 21 L21 13"/></svg>` },
  { title: 'Кэшбэк 5% часами', desc: 'Завершил бронь — получил часы на следующую. Бонусы не сгорают.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="11"/><path d="M14 7 L16 12 L22 12 L17 15 L19 21 L14 17 L9 21 L11 15 L6 12 L12 12 Z" fill="currentColor" stroke="none"/></svg>` },
  { title: 'Без сюрпризов', desc: 'Оплата картой Visa/Mastercard/Kaspi. Возврат на ту же карту, если что.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="24" height="16" rx="3"/><path d="M2 11 H26"/><path d="M6 17 H10 M14 17 H18"/></svg>` },
];

const clubBenefits = [
  { title: 'Поток клиентов', desc: 'Тысячи игроков ищут клубы в твоём районе. Мы доставляем — ты обслуживаешь.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3 L22 8 V18 L14 23 L6 18 V8 Z"/><path d="M14 13 V23 M6 8 L14 13 L22 8"/></svg>` },
  { title: 'Онлайн-платежи', desc: 'Деньги приходят на счёт клуба сразу. Без наличных, без админских споров.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 V21 C3 22 4 23 5 23 H23 C24 23 25 22 25 21 V17"/><path d="M14 3 V17 M9 12 L14 17 L19 12"/></svg>` },
  { title: 'Аналитика и календарь', desc: 'Видишь загрузку по часам и дням. Понимаешь когда поднять цену, когда сделать акцию.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21 V5 M3 21 H25"/><path d="M7 17 V13 M12 17 V8 M17 17 V11 M22 17 V6"/></svg>` },
  { title: 'Без подписки', desc: 'Платишь только комиссию с реальных броней. Если игроков нет — ты ничего не платишь.', icon: `<svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="11"/><path d="M9 14 H19 M14 9 V19"/></svg>` },
];

// Use the canonical CITIES list (id + label) so URLs use slug `?city=almaty`
// which matches the catalog filter logic in filters.ts (strict id equality).
// Russian labels in URLs were a bug — they never matched because club.city
// holds the slug, not the label.
const cities = CITIES;

function fmtPrice(n: number): string {
  return new Intl.NumberFormat('ru-RU').format(n);
}
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>respawn.kz — Бронируй компьютерные клубы в Казахстане</title>
  <meta name="description" content="respawn.kz — онлайн-бронирование компьютерных клубов в Казахстане. 80+ клубов в 10 городах. Выбирай слот, оплачивай онлайн, приходи играть." />
  <link rel="canonical" href="https://respawn.kz/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0a0a0f" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="respawn.kz" />
  <meta property="og:title" content="respawn.kz — Бронируй компьютерные клубы в Казахстане" />
  <meta property="og:description" content="80+ клубов в 10 городах. Выбирай слот, оплачивай онлайн, приходи играть." />
  <meta property="og:image" content="https://respawn.kz/img/club-hero.webp" />
  <meta property="og:url" content="https://respawn.kz/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="v4-root">
  <BetaBanner />

  <header class="v4-header" id="v4-header">
    <div class="v4-header__inner">
      <a href="#top" class="v4-logo" aria-label="respawn.kz home">respawn.kz</a>
      <nav class="v4-nav" aria-label="Главная навигация">
        <a href="#catalog" class="v4-nav-link">Клубы</a>
        <a href="#cities" class="v4-nav-link">Города</a>
        <a href="/for-clubs/" class="v4-nav-link">Для клубов</a>
        <a href="#faq" class="v4-nav-link">Помощь</a>
      </nav>
      <div class="v4-header__actions">
        <a href="/login/" class="v4-btn v4-btn--ghost v4-btn--sm">Войти</a>
        <a href="#catalog" class="v4-btn v4-btn--primary v4-btn--sm">Найти клуб</a>
      </div>
      <button class="v4-hamburger" id="v4-hamburger" aria-label="Открыть меню" aria-expanded="false" aria-controls="v4-drawer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>
        </svg>
      </button>
    </div>
  </header>

  <div class="v4-drawer-root" id="v4-drawer" hidden>
    <div class="v4-drawer__backdrop" data-drawer-close></div>
    <aside class="v4-drawer__panel" role="dialog" aria-modal="true" aria-label="Меню">
      <div class="v4-drawer__top">
        <span class="v4-logo">respawn.kz</span>
        <button class="v4-hamburger" aria-label="Закрыть меню" data-drawer-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 6l12 12"/><path d="M18 6L6 18"/>
          </svg>
        </button>
      </div>
      <nav class="v4-drawer__nav" aria-label="Мобильная навигация">
        <a href="#catalog" class="v4-drawer__nav-link" data-drawer-close>Клубы</a>
        <a href="#cities" class="v4-drawer__nav-link" data-drawer-close>Города</a>
        <a href="/for-clubs/" class="v4-drawer__nav-link">Для клубов</a>
        <a href="#faq" class="v4-drawer__nav-link" data-drawer-close>Помощь</a>
      </nav>
      <div class="v4-drawer__actions">
        <a href="/login/" class="v4-btn v4-btn--ghost">Войти</a>
        <a href="#catalog" class="v4-btn v4-btn--primary">Найти клуб</a>
      </div>
    </aside>
  </div>

  <main>
    <!-- HERO: pinned 300vh with scroll-scrub portal video -->
    <section id="top" class="v4-hero" aria-label="Hero" data-v4-hero>
      <div class="v4-hero__sticky">
        <video
          class="v4-hero__video"
          id="v4-hero-video"
          muted
          playsinline
          preload="auto"
          poster="/videos/hero-portal-poster.jpg"
          aria-hidden="true">
          <source src="/videos/hero-portal.mp4" type="video/mp4" />
        </video>
        <img
          class="v4-hero__poster-img"
          src="/videos/hero-portal-poster.jpg"
          alt=""
          aria-hidden="true"
          data-v4-poster
          hidden
        />
        <div class="v4-hero__vignette" aria-hidden="true"></div>

        <!-- Beat 1: opening — pre-portal -->
        <div class="v4-hero__beat v4-hero__beat--1" data-beat="1">
          <div class="v4-hero__beat-inner">
            <h1 class="v4-h-hero">
              Лучшие клубы Казахстана.<br />
              <span class="v4-secondary">Один тап до игры.</span>
            </h1>
            <div class="v4-hero__cta-stack">
              <a href="#catalog" class="v4-btn v4-btn--primary v4-btn--lg">Найти клуб</a>
            </div>
          </div>
        </div>

        <!-- Beat 3: post-portal — promise -->
        <div class="v4-hero__beat v4-hero__beat--3" data-beat="3">
          <div class="v4-hero__beat-inner">
            <h2 class="v4-h-section">
              Забронируй слот за <span class="v4-mono v4-accent">30</span>&nbsp;секунд.<br />
              <span class="v4-secondary">Без звонков, без очередей.</span>
            </h2>
          </div>
        </div>

        <div class="v4-hero__cue" data-cue>
          <span class="v4-eyebrow">↓ Прокрути ↓</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </div>

        <div class="v4-hero__dots" aria-hidden="true">
          <span class="v4-hero__dot is-active" data-dot="0"></span>
          <span class="v4-hero__dot" data-dot="1"></span>
          <span class="v4-hero__dot" data-dot="2"></span>
        </div>
      </div>
    </section>

    <!-- SEARCH BAR — sits right under the hero so the first thing after the
         video reveal is "find a club". Submits to /clubs/ with city+query
         which the catalog page reads via queryToFilters() in filters.ts. -->
    <section class="v4-searchbar-section" aria-label="Поиск клубов">
      <div class="v4-container">
        <form class="v4-searchbar v4-fade-up" action="/clubs/" method="get" role="search">
          <label class="v4-searchbar__field v4-searchbar__field--city">
            <span class="v4-searchbar__label">Город</span>
            <select name="city" class="v4-searchbar__select" aria-label="Город">
              <option value="">Все города</option>
              {cities.map((c) => (
                <option value={c.id}>{c.label}</option>
              ))}
            </select>
          </label>
          <label class="v4-searchbar__field v4-searchbar__field--query">
            <span class="v4-searchbar__label">Что ищешь</span>
            <input
              type="search"
              name="q"
              class="v4-searchbar__input"
              placeholder="Название клуба, район, теги (PC, PS5, VR…)"
              aria-label="Поиск клубов"
              autocomplete="off"
            />
          </label>
          <button type="submit" class="v4-btn v4-btn--primary v4-searchbar__submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <path d="M21 21l-4.3-4.3"/>
            </svg>
            <span>Найти</span>
          </button>
        </form>
      </div>
    </section>

    <!-- CATALOG TEASER (real clubs from Supabase) -->
    <section id="catalog" class="v4-section" aria-label="Каталог клубов">
      <div class="v4-container">
        <div class="v4-section-head v4-fade-up">
          <span class="v4-eyebrow">Каталог</span>
          <h2 class="v4-h-section">Где играть прямо сейчас</h2>
        </div>
        <div class="v4-catalog__grid">
          {topClubs.map((club) => (
            <a href={`/clubs/${club.slug}/`} class="v4-card v4-fade-up" style="text-decoration:none;color:inherit;">
              <div class="v4-card__photo" style={club.photos?.[0] ? `background-image:url(${club.photos[0]});background-size:cover;background-position:center;` : ''}>
                {!club.photos?.[0] && (
                  <div class="v4-card__photo-caption">{club.initial || club.name.charAt(0).toUpperCase()}</div>
                )}
              </div>
              <div class="v4-card__divider"></div>
              <div class="v4-card__body">
                <h3 class="v4-card__title">{club.name}</h3>
                <p class="v4-card__meta">{club.city}{club.district ? ` · ${club.district}` : ''}</p>
                <div class="v4-card__rating v4-mono">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/>
                  </svg>
                  <span class="v4-accent">{club.rating.toFixed(1)}</span>
                  <span class="v4-muted">({club.reviews_count}&nbsp;отзывов)</span>
                </div>
                <p class="v4-card__price v4-mono">от <span class="v4-accent">{fmtPrice(club.price_per_hour)} ₸</span> /час</p>
              </div>
            </a>
          ))}
        </div>

        <div class="v4-catalog__cta-row">
          <a href="/clubs/" class="v4-catalog__all v4-fade-up">
            Все <span class="v4-mono">{allClubs.length}+</span> клубов
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- THREE STEPS -->
    <section id="how" class="v4-section" aria-label="Три шага до игры">
      <div class="v4-container">
        <div class="v4-section-head v4-fade-up">
          <span class="v4-eyebrow">Как это работает</span>
          <h2 class="v4-h-section">Три шага до игры</h2>
        </div>
        <div class="v4-steps">
          {steps.map((s) => (
            <article class="v4-step v4-fade-up">
              <div class="v4-step__num">{s.num}</div>
              <div class="v4-step__icon" set:html={s.icon}></div>
              <h3 class="v4-step__title">{s.title}</h3>
              <p class="v4-step__desc">{s.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BENEFITS SPLIT (Players + Clubs) -->
    <section id="benefits" class="v4-section" aria-label="Кому это полезно">
      <div class="v4-container">
        <div class="v4-section-head v4-fade-up" style="text-align:center;margin-inline:auto;align-items:center;">
          <span class="v4-eyebrow">Аудитория</span>
          <h2 class="v4-h-section">Кому это полезно</h2>
        </div>
        <div class="v4-benefits">
          <div class="v4-benefits__column v4-fade-up">
            <span class="v4-benefits__chip">Игрокам</span>
            <h3 class="v4-benefits__title">Бронируй и играй без головняка</h3>
            <div class="v4-benefits__list">
              {playerBenefits.map((b) => (
                <div class="v4-benefit">
                  <div class="v4-benefit__icon" set:html={b.icon}></div>
                  <div>
                    <h4 class="v4-benefit__title">{b.title}</h4>
                    <p class="v4-benefit__desc">{b.desc}</p>
                  </div>
                </div>
              ))}
            </div>
            <a href="/clubs/" class="v4-btn v4-btn--primary">Найти клуб</a>
          </div>

          <div class="v4-benefits__column v4-fade-up">
            <span class="v4-benefits__chip v4-benefits__chip--owners">Клубам</span>
            <h3 class="v4-benefits__title">Подключайся и принимай брони</h3>
            <div class="v4-benefits__list">
              {clubBenefits.map((b) => (
                <div class="v4-benefit">
                  <div class="v4-benefit__icon" set:html={b.icon}></div>
                  <div>
                    <h4 class="v4-benefit__title">{b.title}</h4>
                    <p class="v4-benefit__desc">{b.desc}</p>
                  </div>
                </div>
              ))}
            </div>
            <a href="/for-clubs/" class="v4-btn v4-btn--ghost">Подключить клуб</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CITIES + STATS -->
    <section id="cities" class="v4-section" aria-label="География">
      <div class="v4-container">
        <div class="v4-cities__heading v4-fade-up">
          <h2 class="v4-h-section">10 городов Казахстана</h2>
          <p>От Алматы до Атырау — клубы из всех крупных городов в одном каталоге</p>
        </div>
        <div class="v4-cities__pills v4-fade-up">
          {cities.map((city) => (
            <a href={`/clubs/?city=${city.id}`} class="v4-cities__pill">
              <span class="v4-cities__pin" aria-hidden="true"></span>
              {city.label}
            </a>
          ))}
        </div>
        <div class="v4-stats v4-fade-up">
          <div class="v4-stat">
            <span class="v4-stat__value">{allClubs.length}+</span>
            <span class="v4-stat__label">проверенных клубов</span>
          </div>
          <div class="v4-stat">
            <span class="v4-stat__value">12 000+</span>
            <span class="v4-stat__label">активных игроков</span>
          </div>
          <div class="v4-stat">
            <span class="v4-stat__value">30 сек</span>
            <span class="v4-stat__label">занимает бронь</span>
          </div>
          <div class="v4-stat">
            <span class="v4-stat__value">5%</span>
            <span class="v4-stat__label">кэшбэк часами</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="v4-section" aria-label="Частые вопросы">
      <div class="v4-container">
        <div class="v4-section-head v4-fade-up">
          <span class="v4-eyebrow">Помощь</span>
          <h2 class="v4-h-section">Частые вопросы</h2>
        </div>
        <div class="v4-faq__list">
          {LANDING_FAQ.map((item) => (
            <details class="v4-faq__item v4-fade-up" name="v4-faq-group">
              <summary class="v4-faq__question">
                <span>{item.q}</span>
                <span class="v4-faq__icon" aria-hidden="true">+</span>
              </summary>
              <div class="v4-faq__answer">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="v4-final-cta" aria-label="Готов играть?">
      <div class="v4-bloom" aria-hidden="true"></div>
      <div class="v4-container" style="max-width:1200px;position:relative;">
        <h2 class="v4-h-hero v4-final-cta__h v4-fade-up">Готов играть?</h2>
        <a href="#catalog" class="v4-btn v4-btn--primary v4-btn--lg v4-final-cta__btn v4-fade-up">Найти свой клуб</a>
        <p class="v4-mono v4-final-cta__stats v4-fade-up">
          <span class="v4-accent">12 000+</span> игроков
          &nbsp;·&nbsp;
          <span class="v4-accent">80+</span> клубов
          &nbsp;·&nbsp;
