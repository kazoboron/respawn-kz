---
/**
 * Fast-flying starfield background — replaces the static ambient orbs.
 * Canvas full-viewport, position:fixed z-index:-1 so site content sits
 * above it. Stars have x/y/z (depth), each frame z decreases (move toward
 * viewer), perspective projection makes near stars trail outward as
 * streaks — Star Wars / cyberpunk hyperspace effect.
 *
 * Performance:
 * - 220 stars (tuned for smooth 60fps on mid mobile)
 * - Canvas only resizes on window resize, not per-frame
 * - Reduced-motion: stars freeze, just a static field
 * - Saves battery via document.hidden — pauses rAF when tab not visible
 *
 * Used on every page (BaseLayout + v4 index.astro) so the visual is
 * consistent across the whole site.
 */
---

<canvas id="starfield-canvas" class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, #0a0820 0%, #050414 60%, #000000 100%);
  }
</style>

<script is:inline>
  (() => {
    const canvas = document.getElementById('starfield-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 2026-05-XX: switched from forward hyperspace (z-axis perspective)
    // to a horizontal right-to-left scroll per user request. Stars
    // travel leftward at varying parallax speeds — closer stars (bigger,
    // brighter) move faster than far stars. Effect is a calm "moving
    // through space sideways" feel, no streaks/trails.
    const STAR_COUNT = 220;
    const BASE_SPEED = 0.35;      // px per frame for the slowest layer
    const SPEED_RANGE = 1.2;      // additional px on top for fastest layer
    const ACCENT_HUE = 264;       // violet matching v4 palette

    let w = 0, h = 0, dpr = 1;
    let stars = [];

    function makeStar(initial) {
      // Depth 0..1 — used for parallax speed + size + brightness
      const depth = Math.random();
      // 4% of stars become "diamonds" — large bright cores with 4-point
      // cross glare rays. Visually dominate the field at any given moment.
      const diamond = Math.random() < 0.04;
      return {
        // If initial=true, spread across whole screen; otherwise spawn at right edge
        x: initial ? Math.random() * w : w + Math.random() * 50,
        y: Math.random() * h,
        depth,
        speed: BASE_SPEED + depth * SPEED_RANGE,
        size: diamond ? 1.8 + depth * 1.4 : 0.4 + depth * 1.6,
        brightness: diamond ? 0.9 : 0.25 + depth * 0.75,
        accent: !diamond && Math.random() < 0.18, // diamonds stay pure white for max sparkle
        diamond,
        rayLen: diamond ? 7 + Math.random() * 9 : 0, // cross-ray length in px
        // Chaotic twinkling — each star has its own clock + amplitude
        // so they sparkle independently rather than in lockstep.
        twinklePhase: Math.random() * Math.PI * 2,
        // Diamonds pulse slower + with more drama (deeper amplitude)
        twinkleSpeed: diamond ? 0.4 + Math.random() * 1.6 : 0.5 + Math.random() * 4.5,
        twinkleAmp: diamond ? 0.55 + Math.random() * 0.4 : 0.35 + Math.random() * 0.55,
        // Flares: rare for normal stars, slightly more often for diamonds
        flareChance: diamond
          ? 0.001 + Math.random() * 0.004
          : (Math.random() < 0.06 ? Math.random() * 0.003 : 0),
        flareUntil: 0,
      };
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Pre-render a sparkle sprite once — gradient cross + halo with
    // smooth alpha falloff. Drawing this via drawImage looks anti-aliased
    // and reads as 'lens flare', not pixel-thin lines. 1 drawImage per
    // diamond per frame instead of 4 strokes + 2 fills.
    const SPRITE_SIZE = 64;       // px in sprite space; we scale down at draw time
    let sparkleSprite = null;
    function buildSparkleSprite() {
      const c = document.createElement('canvas');
      c.width = c.height = SPRITE_SIZE;
      const cx = SPRITE_SIZE / 2;
      const sctx = c.getContext('2d');
      if (!sctx) return null;
      sctx.translate(cx, cx);

      // Soft round halo behind everything
      const halo = sctx.createRadialGradient(0, 0, 0, 0, 0, cx);
      halo.addColorStop(0,    'rgba(255,255,255,0.55)');
      halo.addColorStop(0.18, 'rgba(255,255,255,0.18)');
      halo.addColorStop(0.55, 'rgba(255,255,255,0.04)');
      halo.addColorStop(1,    'rgba(255,255,255,0)');
      sctx.fillStyle = halo;
      sctx.fillRect(-cx, -cx, SPRITE_SIZE, SPRITE_SIZE);

      // 4-point cross via linear gradients (transparent → bright → transparent).
      // Drawn as thin rects with gradients so edges fade naturally — no pixel
      // ladder like ctx.stroke() with line width <1.
      const rayHalf = cx * 0.92;         // ray reaches almost to sprite edge
      const rayThick = 1.4;
      const lg = (x0, y0, x1, y1) => {
        const g = sctx.createLinearGradient(x0, y0, x1, y1);
        g.addColorStop(0,   'rgba(255,255,255,0)');
        g.addColorStop(0.5, 'rgba(255,255,255,0.95)');
        g.addColorStop(1,   'rgba(255,255,255,0)');
        return g;
      };
      // Horizontal ray
      sctx.fillStyle = lg(-rayHalf, 0, rayHalf, 0);
      sctx.fillRect(-rayHalf, -rayThick / 2, rayHalf * 2, rayThick);
      // Vertical ray
      sctx.fillStyle = lg(0, -rayHalf, 0, rayHalf);
      sctx.fillRect(-rayThick / 2, -rayHalf, rayThick, rayHalf * 2);

      // Bright tiny core in the middle (slightly larger than the rays
      // intersection so the center reads as a sharp point, not a cross)
      const core = sctx.createRadialGradient(0, 0, 0, 0, 0, 4);
      core.addColorStop(0, 'rgba(255,255,255,1)');
      core.addColorStop(0.6, 'rgba(255,255,255,0.4)');
      core.addColorStop(1, 'rgba(255,255,255,0)');
      sctx.fillStyle = core;
      sctx.beginPath();
      sctx.arc(0, 0, 4, 0, Math.PI * 2);
      sctx.fill();

      return c;
    }

    function init() {
      resize();
      sparkleSprite = buildSparkleSprite();
      stars = Array.from({ length: STAR_COUNT }, () => makeStar(true));
    }

    let lastT = performance.now();

    function frame(now) {
      if (document.hidden) {
        // Tab hidden, skip drawing — reschedule sparsely
        setTimeout(() => requestAnimationFrame(frame), 500);
        return;
      }

      // dt in 60fps-equivalent units, so SPEED reads as px/frame at 60fps
      const dt = Math.min(2, (now - lastT) / 16.667);
      lastT = now;

      // Full clear each frame — no trails, clean pinpoint stars
      ctx.fillStyle = '#050414';
      ctx.fillRect(0, 0, w, h);

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        if (!reduced) s.x -= s.speed * dt;

        if (s.x < -5) {
          // Off-screen left — respawn on right with new y/depth
          Object.assign(s, makeStar(false));
        }

        // Chaotic twinkle — per-star frequency × per-star amplitude.
        // Each star pulses on its own clock so the field looks alive,
        // not synchronized. sin() gives -1..1; we map to (1-amp)..1 so
        // amplitude controls how dim the dimmest moment is.
        const wave = Math.sin(now * 0.001 * s.twinkleSpeed + s.twinklePhase);
        const tw = 1 - s.twinkleAmp + s.twinkleAmp * (wave * 0.5 + 0.5);
        let alpha = s.brightness * tw;

        // Random flares — rare, sharp brightness spikes for ~120ms
        if (s.flareChance > 0) {
          if (now < s.flareUntil) {
            // mid-flare: linearly fade from 1.6x → 1x
            const f = Math.max(0, (s.flareUntil - now) / 120);
            alpha = Math.min(1, alpha + f * 0.7);
          } else if (Math.random() < s.flareChance) {
            s.flareUntil = now + 120;
            alpha = Math.min(1, alpha + 0.7);
          }
        }

        const color = s.accent
          ? `hsla(${ACCENT_HUE}, 90%, 72%, ${alpha})`
          : `rgba(255, 255, 255, ${alpha})`;

        if (s.diamond && sparkleSprite) {
          // Diamond: draw the pre-rendered sparkle sprite scaled by twinkle.
          // The sprite already has a fading gradient cross + halo + core
          // anti-aliased into its pixels, so we get soft edges for free.
          // Total size = rayLen * (twinkle factor) — pulses with the star.
          const size = s.rayLen * (0.7 + tw * 0.5);
          ctx.globalAlpha = alpha;
          ctx.drawImage(sparkleSprite, s.x - size, s.y - size, size * 2, size * 2);
          ctx.globalAlpha = 1;
          // Bright core
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      requestAnimationFrame(frame);
    }

    init();
    window.addEventListener('resize', resize, { passive: true });
    requestAnimationFrame(frame);
  })();
</script>
