---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена — respawn.kz" description="404. Страница не найдена.">
  <section class="not-found">
    <div class="container">
      <div class="not-found__code">404</div>
      <h1 class="not-found__title">Страница не найдена</h1>
      <p class="not-found__subtitle">
        Возможно, ты перешёл по устаревшей ссылке, или клуб переехал. Попробуй найти нужное в каталоге.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn--primary">На главную</a>
        <a href="/clubs/" class="btn btn--ghost">К каталогу клубов</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 80px);
    padding: 140px 0 80px;
    display: flex;
    align-items: center;
    text-align: center;
  }

  .not-found__code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(96px, 16vw, 200px);
    line-height: 1;
    background: linear-gradient(135deg, #3b82f6 0%, #6366f1 50%, #a855f7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-shadow: 0 0 80px rgba(99, 102, 241, 0.3);
    margin-bottom: 24px;
    letter-spacing: -0.04em;
  }

  .not-found__title {
    font-size: clamp(24px, 4vw, 36px);
    margin-bottom: 16px;
  }

  .not-found__subtitle {
    color: var(--text-secondary);
    font-size: 17px;
    max-width: 560px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .not-found__actions {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
