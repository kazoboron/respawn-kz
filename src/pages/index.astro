---
import '../styles/homepage-v2.css';
import '../styles/homepage-v3.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ClubCard from '../components/ClubCard.astro';
import BenefitsSplit from '../components/BenefitsSplit.astro';
import BookingFlowDemo from '../components/BookingFlowDemo.astro';
import CitiesShowcase from '../components/CitiesShowcase.astro';
import HeroVisual from '../components/HeroVisual.astro';
import FAQ from '../components/FAQ.astro';
import { LANDING_FAQ } from '../data/content';
import { loadAllClubs, type ClubRow } from '../lib/clubs-loader';

interface Club {
  slug: string;
  name: string;
  city: string;
  district: string | null;
  address: string;
  phone: string | null;
  price: number;
  rating: number;
  reviews: number;
  tags: string[];
  gradient: string | null;
  initial: string | null;
  photos: string[];
}

function clubRowToDisplay(row: ClubRow): Club {
  return {
    slug: row.slug,
    name: row.name,
    city: row.city,
    district: row.district,
    address: row.address,
    phone: row.phone,
    price: row.price_per_hour,
    rating: row.rating,
    reviews: row.reviews_count,
    tags: row.tags,
    gradient: row.gradient,
    initial: row.initial,
    photos: row.photos ?? [],
  };
}

const clubs = await loadAllClubs();
const allClubs = clubs.map(clubRowToDisplay);
---

<BaseLayout
  title="respawn.kz — Бронируй компьютерные клубы в Казахстане"
  description="respawn.kz — онлайн-бронирование компьютерных клубов в Казахстане. Найди клуб, забронируй слот, оплати картой."
  activeRoute="index"
  lcpImage="/img/club-rows.webp"
>
  <section class="hero" id="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__scanline" aria-hidden="true"></div>

    <HeroVisual />

    <!-- Esports-broadcast-style LIVE badge top-right -->
    <div class="hero__live" aria-label="Платформа активна">
      <span class="hero__live-dot" aria-hidden="true"></span>
      <span>LIVE · сейчас бронируют</span>
    </div>

    <div class="container hero__inner">
      <span class="hero__tagline">Бронь без звонков · 10 городов · 80+ клубов</span>
      <h1 class="hero__title">
        Забронируй компьютерный клуб за <span class="glitch" data-text="30 секунд">30 секунд</span>
      </h1>
      <p class="hero__subtitle">
        Выбирай слот, оплачивай онлайн, приходи играть.
      </p>

      <div class="hero__cta-row">
        <a class="btn btn--primary btn--xl" href="/clubs/?sort=distance" id="hero-geo-cta">
          <span class="hero__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 2 C6 2 3 5 3 9 C3 14 10 18 10 18 C10 18 17 14 17 9 C17 5 14 2 10 2 Z"/>
              <circle cx="10" cy="9" r="2.5"/>
            </svg>
          </span>
          Найти ближайший клуб
        </a>
        <a class="btn btn--ghost btn--xl" href="/clubs/">
          Все клубы
        </a>
      </div>

      <div class="hero__search-block" data-reveal>
        <div class="hero__search-block-label">или укажи параметры:</div>
        <SearchForm variant="hero" />
      </div>
    </div>

    <!-- Esports-broadcast-style stat ticker at the bottom of hero -->
    <div class="hero__ticker" aria-hidden="true">
      <div class="hero__ticker-item">
        <span class="hero__ticker-label">Игроков</span>
        <span class="hero__ticker-value">12 487</span>
      </div>
      <span class="hero__ticker-sep">·</span>
      <div class="hero__ticker-item">
        <span class="hero__ticker-label">Клубов</span>
        <span class="hero__ticker-value">82</span>
      </div>
      <span class="hero__ticker-sep">·</span>
      <div class="hero__ticker-item">
        <span class="hero__ticker-label">Городов</span>
        <span class="hero__ticker-value">10</span>
      </div>
      <span class="hero__ticker-sep">·</span>
      <div class="hero__ticker-item">
        <span class="hero__ticker-label">Бронь</span>
        <span class="hero__ticker-value">~30 сек</span>
      </div>
    </div>
  </section>

  <!-- Clubs list — moved up per user request, full catalog right after hero -->
  <section class="clubs" id="clubs" data-reveal>
    <div class="container">
      <h2 class="section__title">Клубы Казахстана</h2>
      <p class="section__subtitle">{allClubs.length} клубов в 10 городах — выбирай и бронируй</p>
      <div class="clubs__grid">
        {allClubs.map((club) => <ClubCard club={club} />)}
      </div>
      <div class="clubs__more">
        <a class="btn btn--ghost btn--large" href="/clubs/">Открыть каталог с фильтрами</a>
      </div>
    </div>
  </section>

  <!-- Supporting info — moved BELOW clubs per user request -->
  <CitiesShowcase />

  <HowItWorks />

  <BookingFlowDemo />

  <BenefitsSplit />

  <FAQ items={LANDING_FAQ} />

  <section class="cta" id="for-clubs-cta">
    <div class="container cta__inner">
      <div class="cta__visual" aria-hidden="true">
        <div class="cta__visual-orb"></div>
        <div class="cta__visual-orb cta__visual-orb--2"></div>
      </div>
      <h2 class="cta__title">Готов играть?</h2>
      <p class="cta__subtitle">Найди свой клуб и забронируй слот прямо сейчас</p>
      <div class="cta__buttons">
        <a href="/clubs/" class="btn btn--primary btn--xl">Найти клуб</a>
        <a href="/login/" class="btn btn--ghost btn--xl">Войти</a>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span>Алматы</span><span>Астана</span><span>Шымкент</span><span>Караганда</span><span>Актобе</span><span>Тараз</span><span>Павлодар</span><span>Усть-Каменогорск</span><span>Семей</span><span>Атырау</span>
      <span>Алматы</span><span>Астана</span><span>Шымкент</span><span>Караганда</span><span>Актобе</span><span>Тараз</span><span>Павлодар</span><span>Усть-Каменогорск</span><span>Семей</span><span>Атырау</span>
    </div>
  </div>

  <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
</BaseLayout>

<script>
  import { setupScrollReveal } from '../scripts/scroll-reveal';
  import { setupHeroParticles } from '../scripts/hero-particles';
  setupScrollReveal();
  setupHeroParticles();

  const glow = document.getElementById('cursor-glow');
  if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches
      && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let activated = false;
    let rafPending = false;
    let lastX = 0;
    let lastY = 0;
    document.addEventListener('mousemove', (e) => {
      lastX = e.clientX;
      lastY = e.clientY;
      if (!activated) {
        glow.classList.add('is-active');
        activated = true;
      }
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(() => {
          glow.style.transform = `translate(${lastX}px, ${lastY}px) translate(-50%, -50%)`;
          rafPending = false;
        });
      }
    });
    document.addEventListener('mouseleave', () => {
      glow.classList.remove('is-active');
      activated = false;
    });
  }

  const geoBtn = document.getElementById('hero-geo-cta') as HTMLAnchorElement | null;
  if (geoBtn && navigator.geolocation) {
    geoBtn.addEventListener('click', (e) => {
      e.preventDefault();
      geoBtn.style.opacity = '0.7';
      geoBtn.style.pointerEvents = 'none';
      navigator.geolocation.getCurrentPosition(
        () => { window.location.href = '/clubs/?sort=distance'; },
        () => {
          geoBtn.style.opacity = '';
          geoBtn.style.pointerEvents = '';
          window.location.href = '/clubs/';
        },
        { timeout: 8000, maximumAge: 60_000 },
      );
    });
  }
</script>
