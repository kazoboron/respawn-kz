---
interface Props {
  /** Размер иконки (высота). Текст масштабируется пропорционально. */
  size?: 'sm' | 'md' | 'lg';
  /** Только иконка без текста (для favicon-mark) */
  iconOnly?: boolean;
}

const { size = 'md', iconOnly = false } = Astro.props;

const sizes = {
  sm: { icon: 28, text: 18 },
  md: { icon: 34, text: 22 },
  lg: { icon: 72, text: 44 },
};
const dim = sizes[size];
---

<a class="logo-wrap" href="/" aria-label="respawn — главная" style={`--icon-size: ${dim.icon}px; --text-size: ${dim.text}px`}>
  <span class="logo-mark-wrap">
    <svg
      class="logo-mark"
      width={dim.icon}
      height={dim.icon}
      viewBox="0 0 64 64"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="lgGrad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#8b5cf6">
            <animate attributeName="stop-color" values="#8b5cf6;#6366f1;#ec4899;#8b5cf6" dur="8s" repeatCount="indefinite" />
          </stop>
          <stop offset="100%" stop-color="#ec4899">
            <animate attributeName="stop-color" values="#ec4899;#8b5cf6;#6366f1;#ec4899" dur="8s" repeatCount="indefinite" />
          </stop>
        </linearGradient>
        <linearGradient id="lgArc" x1="0" y1="0" x2="64" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#f5e8ff" stop-opacity="0.85" />
        </linearGradient>
      </defs>

      <!-- Soft outer halo -->
      <circle cx="32" cy="32" r="28" fill="url(#lgGrad)" opacity="0.18" filter="blur(8px)" />

      <!-- Main rounded-square base -->
      <rect x="8" y="8" width="48" height="48" rx="14" fill="url(#lgGrad)" />

      <!-- Inner highlight (glassy top) -->
      <rect x="8" y="8" width="48" height="48" rx="14" fill="url(#lgArc)" opacity="0.08" />

      <!-- Respawn loop — circular arc + arrowhead in white -->
      <g stroke="#ffffff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <!-- Open arc (270°) -->
        <path d="M44 22 A14 14 0 1 0 46 36" />
        <!-- Arrowhead at start -->
        <path d="M44 22 L48 18 M44 22 L40 18" />
      </g>

      <!-- Center play triangle (gaming hint) -->
      <path d="M28 26 L40 32 L28 38 Z" fill="#ffffff" opacity="0.95" />
    </svg>
  </span>

  {!iconOnly && (
    <span class="logo-text">respawn</span>
  )}
</a>

<style>
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    line-height: 1;
    text-decoration: none;
    color: inherit;
    transition: transform 250ms ease;
  }

  .logo-wrap:hover {
    transform: translateY(-1px);
  }

  .logo-mark-wrap {
    position: relative;
    display: inline-flex;
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }

  .logo-mark {
    filter: drop-shadow(0 4px 18px rgba(139, 92, 246, 0.45));
    transition: filter 300ms ease, transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .logo-wrap:hover .logo-mark {
    filter: drop-shadow(0 6px 26px rgba(236, 72, 153, 0.55))
            drop-shadow(0 0 14px rgba(139, 92, 246, 0.6));
    transform: rotate(-3deg) scale(1.04);
  }

  .logo-text {
    font-family: 'Inter Tight', 'Inter', system-ui, sans-serif;
    font-size: var(--text-size);
    letter-spacing: -0.035em;
    font-weight: 700;
    line-height: 1;

    /* Animated shimmer gradient */
    background: linear-gradient(
      90deg,
      #f5f4ff 0%,
      #c4b5fd 25%,
      #f472b6 50%,
      #c4b5fd 75%,
      #f5f4ff 100%
    );
    background-size: 200% 100%;
    background-position: 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: logo-shimmer 7s ease-in-out infinite;
  }

  @keyframes logo-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-text {
      animation: none;
      background-position: 50% 50%;
    }
    .logo-wrap:hover .logo-mark {
      transform: none;
    }
  }
</style>
