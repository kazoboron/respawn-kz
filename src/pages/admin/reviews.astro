---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardNav from '../../components/DashboardNav.astro';
---
<BaseLayout
  title="Модерация отзывов — respawn.kz"
  description="Управление отзывами клубов"
>
  <section class="container dashboard-page">
    <DashboardNav variant="admin" active="/admin/reviews/" />
    <header class="dashboard-page__header">
      <h1>Модерация отзывов</h1>
      <p class="dashboard-page__sub">Последние 50 отзывов. Скрытые исключаются из публичного рейтинга клуба.</p>
    </header>

    <div id="admin-reviews-root">
      <fieldset class="admin-filter">
        <legend class="sr-only">Фильтр по статусу</legend>
        <label><input type="radio" name="status-filter" value="all" checked /> Все</label>
        <label><input type="radio" name="status-filter" value="published" /> Опубликованы</label>
        <label><input type="radio" name="status-filter" value="hidden" /> Скрыты</label>
      </fieldset>

      <div id="admin-reviews-loading" class="dashboard-loading" aria-live="polite">
        <p style="text-align:center;color:var(--text-muted)">Загрузка…</p>
      </div>
      <div id="admin-reviews-list" class="admin-reviews-list" aria-busy="true" aria-live="polite"></div>
      <div id="admin-reviews-empty" hidden>
        <p style="text-align:center;color:var(--text-muted)">Отзывов с этим фильтром нет.</p>
      </div>
      <div id="admin-reviews-error" role="alert" hidden style="padding:16px;color:rgb(248,113,113)">
        <p>Не удалось загрузить отзывы. <button type="button" class="btn btn--ghost btn--sm" data-retry-admin-reviews>Повторить</button></p>
      </div>
    </div>
  </section>
</BaseLayout>
