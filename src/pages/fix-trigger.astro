---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fix · respawn.kz">
  <section class="auth-page" id="fix-trigger-root">
    <div class="container">
      <div class="auth-card" style="text-align:center;max-width:680px">
        <h1 class="auth-card__title">Применяю фикс триггера…</h1>
        <p class="auth-card__subtitle" id="fix-status">Connecting…</p>
        <pre id="fix-output" style="text-align:left;background:var(--bg-surface);padding:16px;border-radius:8px;border:1px solid var(--border);font-family:monospace;font-size:13px;white-space:pre-wrap;word-break:break-word;margin-top:24px;min-height:60px"></pre>
        <p style="margin-top:24px;color:var(--text-secondary);font-size:13px">
          Эта страница вызывает одноразовую edge-функцию apply-trigger-fix.
          После «✓ Done» — удалю функцию + страницу.
        </p>
      </div>
    </div>
  </section>
  <script>
    import { supabase } from '../lib/supabase';

    const statusEl = document.getElementById('fix-status') as HTMLElement;
    const outputEl = document.getElementById('fix-output') as HTMLElement;

    function setStatus(text: string, kind?: 'success' | 'error') {
      statusEl.textContent = text;
      statusEl.style.color = kind === 'success' ? 'var(--success)' : kind === 'error' ? 'var(--danger)' : 'var(--text-secondary)';
    }

    (async () => {
      try {
        setStatus('Диагностика — что в БД сейчас…');
        const diag = await supabase.functions.invoke('apply-trigger-fix', { method: 'GET' });
        outputEl.textContent = 'DIAGNOSE:\n' + JSON.stringify(diag.data ?? diag.error, null, 2);

        setStatus('Применяю фикс через POST…');
        await new Promise((r) => setTimeout(r, 500));
        const applied = await supabase.functions.invoke('apply-trigger-fix', { method: 'POST' });
        outputEl.textContent += '\n\nAPPLIED:\n' + JSON.stringify(applied.data ?? applied.error, null, 2);

        if (applied.error) {
          setStatus('❌ Не получилось — см. лог ниже', 'error');
          return;
        }
        const data = applied.data as { after_contains_club_owners?: boolean; after_contains_helper?: boolean };
        if (data?.after_contains_club_owners === false && data?.after_contains_helper === true) {
          setStatus('✓ Готово. Триггер обновлён. Можно бронировать.', 'success');
        } else {
          setStatus('⚠️ Результат не как ожидалось — см. лог', 'error');
        }
      } catch (e) {
        setStatus('❌ Сбой при вызове функции', 'error');
        outputEl.textContent = String(e instanceof Error ? e.message : e);
      }
    })();
  </script>
</BaseLayout>
