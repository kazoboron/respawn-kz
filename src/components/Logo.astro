---
interface Props {
  /** Размер иконки (высота). Текст масштабируется пропорционально. */
  size?: 'sm' | 'md' | 'lg';
  /** Только иконка без текста (для favicon-mark) */
  iconOnly?: boolean;
}

const { size = 'md', iconOnly = false } = Astro.props;

const sizes = {
  sm: { icon: 28, text: 17 },
  md: { icon: 36, text: 22 },
  lg: { icon: 72, text: 44 },
};
const dim = sizes[size];
---

<a class="logo-wrap" href="/" aria-label="respawn — главная" style={`--icon-size: ${dim.icon}px; --text-size: ${dim.text}px`}>
  <span class="logo-mark-wrap">
    <svg
      class="logo-mark"
      width={dim.icon}
      height={dim.icon}
      viewBox="0 0 64 64"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="lgRing" x1="32" y1="6" x2="32" y2="58" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#c4b5fd" />
          <stop offset="55%" stop-color="#8b5cf6" />
          <stop offset="100%" stop-color="#7c3aed" />
        </linearGradient>
        <linearGradient id="lgArrow" x1="48" y1="10" x2="56" y2="22" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#fbcfe8" />
          <stop offset="100%" stop-color="#f472b6" />
        </linearGradient>
        <radialGradient id="lgInner" cx="32" cy="32" r="22" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="rgba(139, 92, 246, 0.18)" />
          <stop offset="100%" stop-color="rgba(139, 92, 246, 0)" />
        </radialGradient>
        <filter id="lgGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.3" />
        </filter>
      </defs>

      <!-- Soft inner halo (violet bloom under the d-pad) -->
      <circle cx="32" cy="32" r="22" fill="url(#lgInner)" />

      <!-- Outer ring — main violet circle -->
      <circle cx="32" cy="32" r="23" stroke="url(#lgRing)" stroke-width="2.8" fill="none" filter="url(#lgGlow)" opacity="0.55" />
      <circle cx="32" cy="32" r="23" stroke="url(#lgRing)" stroke-width="2.2" fill="none" />

      <!-- D-pad: 4 rounded squares arranged in a cross + center dot -->
      <g fill="#a78bfa">
        <rect x="29" y="22" width="6" height="6" rx="1.5" />
        <rect x="29" y="36" width="6" height="6" rx="1.5" />
        <rect x="22" y="29" width="6" height="6" rx="1.5" />
        <rect x="36" y="29" width="6" height="6" rx="1.5" />
        <circle cx="32" cy="32" r="1.8" fill="#c4b5fd" />
      </g>

      <!-- Refresh arc at top-right with arrowhead — the 'respawn' loop -->
      <g fill="none" stroke="url(#lgArrow)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M 44 14 A 14 14 0 0 1 51 24" />
        <path d="M 44 14 L 49 14 L 47 19 Z" fill="url(#lgArrow)" stroke="none" />
      </g>
    </svg>
  </span>

  {!iconOnly && (
    <span class="logo-text">respawn</span>
  )}
</a>

<style>
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
    text-decoration: none;
    color: inherit;
    transition: transform 250ms ease;
  }

  .logo-wrap:hover {
    transform: translateY(-1px);
  }

  .logo-mark-wrap {
    position: relative;
    display: inline-flex;
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }

  .logo-mark {
    filter: drop-shadow(0 4px 16px rgba(139, 92, 246, 0.45));
    transition: filter 300ms ease, transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .logo-wrap:hover .logo-mark {
    filter: drop-shadow(0 6px 24px rgba(139, 92, 246, 0.6))
            drop-shadow(0 0 12px rgba(167, 139, 250, 0.5));
    transform: rotate(-6deg);
  }

  .logo-text {
    font-family: 'Inter Tight', 'Inter', system-ui, sans-serif;
    font-size: var(--text-size);
    letter-spacing: -0.035em;
    font-weight: 700;
    line-height: 1;
    color: #ffffff;
  }
</style>
