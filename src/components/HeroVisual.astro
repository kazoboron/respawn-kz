---
/**
 * Hero visual layer v3: looping video background + canvas particle network +
 * animated SVG circuit traces. Three layered backgrounds give depth without
 * any single one carrying the whole "wow" load.
 *
 * Layer order (back to front):
 *   1. <video> background (Pexels-hosted neon/gaming loop, lazy-load via
 *      preload="metadata"; poster fallback to /img/club-rows.webp if the
 *      CDN is unreachable or the user is on reduced-motion / save-data)
 *   2. Dark gradient overlay so headline text reads cleanly
 *   3. Canvas particle network (hero-particles.ts) — packets of light
 *      drifting along node mesh
 *   4. SVG circuit traces with stroke-dashoffset pulses
 *   5. Vignette to focus eye on center
 */
---

<div class="hero-fx" aria-hidden="true">
  <!-- Layer 0: looping gaming-with-person video background.
       Royalty-free Pexels CDN. Two sources for redundancy.
       autoplay + muted + playsinline = iOS/Safari autoplay-friendly.
       Hidden on small screens + prefers-reduced-motion via CSS. -->
  <video
    class="hero-fx__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/img/club-rows.webp"
  >
    <!-- Mixkit CDN allows hot-linking; Pexels recently started returning 403 -->
    <source
      src="https://assets.mixkit.co/videos/41488/41488-720.mp4"
      type="video/mp4"
    />
  </video>

  <!-- Layer 0.5: dark overlay so headline text stays readable over the video -->
  <div class="hero-fx__overlay"></div>

  <!-- Layer 1: canvas particle network -->
  <canvas id="hero-particles" class="hero-fx__canvas"></canvas>

  <!-- Layer 2: SVG circuit traces with pulsing current -->
  <svg class="hero-fx__circuits" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="trace-cyan" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="rgba(0, 229, 255, 0)" />
        <stop offset="50%" stop-color="rgba(0, 229, 255, 1)" />
        <stop offset="100%" stop-color="rgba(0, 229, 255, 0)" />
      </linearGradient>
      <linearGradient id="trace-magenta" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="rgba(255, 0, 128, 0)" />
        <stop offset="50%" stop-color="rgba(255, 0, 128, 1)" />
        <stop offset="100%" stop-color="rgba(255, 0, 128, 0)" />
      </linearGradient>
      <filter id="trace-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Static faint trace grid (always visible) -->
    <g stroke="rgba(168, 85, 247, 0.12)" stroke-width="1" fill="none">
      <path d="M0 200 L300 200 L350 250 L600 250 L650 200 L900 200 L950 250 L1440 250" />
      <path d="M0 450 L200 450 L250 400 L500 400 L550 450 L800 450 L850 400 L1440 400" />
      <path d="M0 680 L400 680 L450 730 L750 730 L800 680 L1440 680" />
      <path d="M720 0 L720 150 L770 200 L770 350 L720 400 L720 550 L770 600 L770 900" />
      <path d="M300 0 L300 100 L350 150 L350 320 L300 370 L300 900" />
      <path d="M1100 0 L1100 180 L1050 230 L1050 400 L1100 450 L1100 900" />
      <!-- nodes at junctions -->
      <circle cx="300" cy="200" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="650" cy="200" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="950" cy="250" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="250" cy="400" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="550" cy="450" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="850" cy="400" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="450" cy="730" r="4" fill="rgba(168, 85, 247, 0.25)" />
      <circle cx="800" cy="680" r="4" fill="rgba(168, 85, 247, 0.25)" />
    </g>

    <!-- Pulsing traces — animated stroke-dashoffset gives "current flowing" -->
    <g fill="none" stroke-width="2" stroke-linecap="round" filter="url(#trace-glow)">
      <path class="trace trace--cyan" d="M0 200 L300 200 L350 250 L600 250 L650 200 L900 200 L950 250 L1440 250" stroke="url(#trace-cyan)" />
      <path class="trace trace--magenta" d="M0 450 L200 450 L250 400 L500 400 L550 450 L800 450 L850 400 L1440 400" stroke="url(#trace-magenta)" />
      <path class="trace trace--cyan-2" d="M720 0 L720 150 L770 200 L770 350 L720 400 L720 550 L770 600 L770 900" stroke="url(#trace-cyan)" />
      <path class="trace trace--magenta-2" d="M300 0 L300 100 L350 150 L350 320 L300 370 L300 900" stroke="url(#trace-magenta)" />
    </g>
  </svg>

  <!-- Vignette to soften edges and improve text contrast -->
  <div class="hero-fx__vignette"></div>
</div>
