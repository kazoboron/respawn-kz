---
interface Props {
  /** Размер иконки (высота). Текст масштабируется пропорционально. */
  size?: 'sm' | 'md' | 'lg';
  /** Только иконка без текста (для favicon-mark или иконок) */
  iconOnly?: boolean;
}

const { size = 'md', iconOnly = false } = Astro.props;

const sizes = {
  sm: { icon: 24, text: 16 },
  md: { icon: 32, text: 20 },
  lg: { icon: 64, text: 40 },
};
const dim = sizes[size];
---

<span class="logo-wrap" style={`--icon-size: ${dim.icon}px; --text-size: ${dim.text}px`}>
  <svg
    class="logo-mark"
    width={dim.icon}
    height={dim.icon}
    viewBox="0 0 64 64"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="respawn.kz logo"
  >
    <defs>
      <linearGradient id="pinGrad" x1="0" y1="0" x2="64" y2="64">
        <stop offset="0%" stop-color="#3b82f6" />
        <stop offset="60%" stop-color="#6366f1" />
        <stop offset="100%" stop-color="#a855f7" />
      </linearGradient>
      <linearGradient id="pinGlow" x1="0" y1="0" x2="0" y2="64">
        <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#a855f7" stop-opacity="0" />
      </linearGradient>
    </defs>
    <!-- Pin shape (teardrop) -->
    <path
      d="M32 4 C18.7 4 8 14.5 8 27.5 C8 42 27 58 30.5 60.5 C31.4 61.2 32.6 61.2 33.5 60.5 C37 58 56 42 56 27.5 C56 14.5 45.3 4 32 4 Z"
      fill="url(#pinGrad)"
    />
    <!-- Circular respawn arrow -->
    <path
      d="M18 14 A22 22 0 0 1 50 16 L46 12 M50 16 L44 18"
      stroke="#ffffff"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
      opacity="0.95"
    />
    <!-- Gamepad icon (white, centered) -->
    <g transform="translate(18 22)" fill="#ffffff">
      <!-- Body -->
      <path d="M5 4 H23 C26 4 28 6 28 9 V15 C28 18 26 20 23 20 H20 L17.5 16 H10.5 L8 20 H5 C2 20 0 18 0 15 V9 C0 6 2 4 5 4 Z" />
      <!-- D-pad cross (cut-out via overlay) -->
      <rect x="5.5" y="10.5" width="6" height="2" fill="#3b5fdf" rx="0.5" />
      <rect x="7.5" y="8.5" width="2" height="6" fill="#3b5fdf" rx="0.5" />
      <!-- Buttons -->
      <circle cx="20" cy="9.5" r="1.3" fill="#3b5fdf" />
      <circle cx="23" cy="12" r="1.3" fill="#3b5fdf" />
      <circle cx="20" cy="14.5" r="1.3" fill="#3b5fdf" />
      <circle cx="17" cy="12" r="1.3" fill="#3b5fdf" />
    </g>
  </svg>

  {!iconOnly && (
    <span class="logo-text">
      <span class="logo-text__main">RESPAWN</span><span class="logo-text__accent">.kz</span>
    </span>
  )}
</span>

<style>
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }

  .logo-mark {
    filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.4));
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-size);
    letter-spacing: -0.025em;
    font-weight: 800;
    display: inline-flex;
    align-items: baseline;
  }

  .logo-text__main {
    color: var(--text-primary);
  }

  .logo-text__accent {
    color: var(--accent);
    font-weight: 600;
    margin-left: 1px;
  }
</style>
