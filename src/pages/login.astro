---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Войти — respawn.kz"
  description="Войди в respawn.kz через magic link"
>
  <section class="auth-page">
    <div class="container">
      <div class="auth-card">
        <h1 class="auth-card__title">Войти</h1>
        <p class="auth-card__subtitle">Введи email — мы отправим ссылку. Кликнешь — войдёшь. Без пароля.</p>

        <div class="demo-banner" id="login-demo-banner" hidden>
          ⚙️ <strong>Demo-режим</strong>: данные сохраняются локально в браузере. Любой email подойдёт, письмо не отправляется.
        </div>

        <form class="auth-form" id="login-form">
          <label class="auth-field" for="login-email">
            <span class="auth-label">Email</span>
            <input
              type="email"
              id="login-email"
              name="email"
              required
              class="auth-input"
              placeholder="you@example.com"
              autocomplete="email"
              aria-describedby="login-error login-success"
              aria-invalid="false"
            />
          </label>
          <button type="submit" class="btn btn--primary btn--large auth-submit">Получить ссылку</button>
        </form>

        <div class="auth-success" id="login-success" aria-live="polite" role="status" hidden>
          <p>📨 Письмо отправлено на <strong data-email></strong></p>
          <p style="margin-top:8px">Проверь почту (включая спам) — кликни по ссылке.</p>
        </div>

        <div class="auth-error" id="login-error" aria-live="polite" hidden></div>

        <p class="auth-footnote">Регистрация автоматическая — если входишь впервые, аккаунт создастся.</p>
      </div>
    </div>
  </section>
</BaseLayout>
