  <script>
    // Header scrolled state
    (() => {
      const header = document.getElementById('v4-header');
      if (!header) return;
      const onScroll = () => {
        if (window.scrollY > 80) header.classList.add('is-scrolled');
        else header.classList.remove('is-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();

    // Mobile drawer
    (() => {
      const drawer = document.getElementById('v4-drawer');
      const hamburger = document.getElementById('v4-hamburger');
      if (!drawer || !hamburger) return;
      const open = () => {
        drawer.hidden = false;
        hamburger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        drawer.hidden = true;
        hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      };
      hamburger.addEventListener('click', open);
      drawer.querySelectorAll('[data-drawer-close]').forEach((el) => {
        el.addEventListener('click', close);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) close();
      });
    })();

    // Hero scroll-scrub + beat overlays
    (() => {
      const hero = document.querySelector('[data-v4-hero]');
      if (!hero) return;
      const video = /** @type {HTMLVideoElement|null} */ (document.getElementById('v4-hero-video'));
      const poster = hero.querySelector('[data-v4-poster]');
      const beats = hero.querySelectorAll('[data-beat]');
      const dots = hero.querySelectorAll('[data-dot]');
      const cue = hero.querySelector('[data-cue]');

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      const setStaticMode = () => {
        // Reduced-motion only: pause video, show static poster, freeze beats
        if (video) {
          video.style.display = 'none';
          try { video.pause(); } catch (_) {}
        }
        if (poster) poster.removeAttribute('hidden');
        beats.forEach((b) => {
          b.classList.toggle('is-active', b.dataset.beat === '1');
        });
        if (cue) cue.classList.remove('is-active');
        dots.forEach((d, i) => d.classList.toggle('is-active', i === 0));
      };

      const setInteractiveMode = () => {
        // Scroll-scrub mode (desktop + mobile): pause autoplay, reset, scrub
        // controls currentTime as user scrolls.
        // iOS Safari quirk: setting currentTime before loadedmetadata is a no-op.
        // We "prime" the video by attempting play()+pause() once muted+playsinline
        // are set so the browser allocates the decoder. From there, subsequent
        // currentTime writes update frames inline.
        if (poster) poster.setAttribute('hidden', '');
        if (video) {
          video.style.display = 'block';
          video.loop = false;
          video.muted = true;
          const prime = () => {
            try {
              const p = video.play();
              if (p && typeof p.then === 'function') {
                p.then(() => { try { video.pause(); video.currentTime = 0; } catch (_) {} })
                 .catch(() => { /* autoplay blocked; scrub may still work after first user gesture */ });
              } else {
                try { video.pause(); video.currentTime = 0; } catch (_) {}
              }
            } catch (_) {}
          };
          if (video.readyState >= 1) prime();
          else video.addEventListener('loadedmetadata', prime, { once: true });
        }
      };

      const onStateChange = () => {
        if (reduced.matches) setStaticMode();
        else setInteractiveMode();
      };
      onStateChange();
      reduced.addEventListener('change', onStateChange);

      // Lerp video.currentTime toward target every animation frame.
      // Even when scroll stops, the video keeps easing into its final
      // frame, which removes the "stepping" feel of raw scroll-scrub.
      let targetTime = 0;
      let currentTime = 0;
      let tickActive = false;
      const ease = 0.22; // 0.18-0.30 sweet spot — lower = smoother but laggy

      const tick = () => {
        const diff = targetTime - currentTime;
        if (Math.abs(diff) < 0.004) {
          currentTime = targetTime;
          if (video) { try { video.currentTime = currentTime; } catch (_) {} }
          tickActive = false;
          return;
        }
        currentTime += diff * ease;
        if (video) { try { video.currentTime = currentTime; } catch (_) {} }
        requestAnimationFrame(tick);
      };

      const startTick = () => {
        if (tickActive) return;
        tickActive = true;
        requestAnimationFrame(tick);
      };

      let rafPending = false;
      let lastProgress = -1;
      const update = () => {
        rafPending = false;
        if (reduced.matches) return;
        const rect = hero.getBoundingClientRect();
        const total = hero.offsetHeight - window.innerHeight;
        const passed = Math.min(Math.max(-rect.top, 0), total);
        const progress = total > 0 ? passed / total : 0;
        if (Math.abs(progress - lastProgress) < 0.0005) return;
        lastProgress = progress;

        if (video && video.duration && isFinite(video.duration)) {
          targetTime = Math.min(Math.max(progress, 0), 0.9999) * video.duration;
          startTick();
        }

        const beat1Active = progress < 0.33;
        const beat3Active = progress >= 0.66;
        beats.forEach((b) => {
          const which = b.dataset.beat;
          if (which === '1') b.classList.toggle('is-active', beat1Active);
          else if (which === '3') b.classList.toggle('is-active', beat3Active);
        });
        dots.forEach((d, i) => {
          const active =
            (i === 0 && beat1Active) ||
            (i === 1 && !beat1Active && !beat3Active) ||
            (i === 2 && beat3Active);
          d.classList.toggle('is-active', active);
        });
        if (cue) cue.classList.toggle('is-active', beat1Active && progress < 0.15);
      };

      const onScroll = () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      // Initial paint synchronously (rAF is paused on hidden tabs).
      update();
      requestAnimationFrame(update);
    })();

    // Fade-up reveal
    (() => {
      const els = document.querySelectorAll('.v4-fade-up');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      els.forEach((el) => io.observe(el));
    })();
  </script>
</body>
