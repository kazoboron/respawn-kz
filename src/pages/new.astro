---
import '../styles/respawn-v4.css';
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>respawn.kz — лучшие клубы Казахстана</title>
  <meta name="description" content="Онлайн-бронирование лучших компьютерных клубов Казахстана. 80+ клубов в 10 городах." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="v4-root">

  <header class="v4-header" id="v4-header">
    <div class="v4-header__inner">
      <a href="#top" class="v4-logo" aria-label="respawn.kz home">respawn.kz</a>
      <nav class="v4-nav" aria-label="Главная навигация">
        <a href="#catalog" class="v4-nav-link">Клубы</a>
        <a href="#cities" class="v4-nav-link">Города</a>
        <a href="#owners" class="v4-nav-link">Для клубов</a>
        <a href="#help" class="v4-nav-link">Помощь</a>
      </nav>
      <div class="v4-header__actions">
        <a href="/login/" class="v4-btn v4-btn--ghost v4-btn--sm">Войти</a>
        <a href="#catalog" class="v4-btn v4-btn--primary v4-btn--sm">Найти клуб</a>
      </div>
      <button class="v4-hamburger" id="v4-hamburger" aria-label="Открыть меню" aria-expanded="false" aria-controls="v4-drawer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>
        </svg>
      </button>
    </div>
  </header>

  <div class="v4-drawer-root" id="v4-drawer" hidden>
    <div class="v4-drawer__backdrop" data-drawer-close></div>
    <aside class="v4-drawer__panel" role="dialog" aria-modal="true" aria-label="Меню">
      <div class="v4-drawer__top">
        <span class="v4-logo">respawn.kz</span>
        <button class="v4-hamburger" aria-label="Закрыть меню" data-drawer-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 6l12 12"/><path d="M18 6L6 18"/>
          </svg>
        </button>
      </div>
      <nav class="v4-drawer__nav" aria-label="Мобильная навигация">
        <a href="#catalog" class="v4-drawer__nav-link" data-drawer-close>Клубы</a>
        <a href="#cities" class="v4-drawer__nav-link" data-drawer-close>Города</a>
        <a href="#owners" class="v4-drawer__nav-link" data-drawer-close>Для клубов</a>
        <a href="#help" class="v4-drawer__nav-link" data-drawer-close>Помощь</a>
      </nav>
      <div class="v4-drawer__actions">
        <a href="/login/" class="v4-btn v4-btn--ghost">Войти</a>
        <a href="#catalog" class="v4-btn v4-btn--primary">Найти клуб</a>
      </div>
    </aside>
  </div>

  <main>
    <!-- HERO: pinned 300vh with scroll-scrub portal video -->
    <section id="top" class="v4-hero" aria-label="Hero" data-v4-hero>
      <div class="v4-hero__sticky">
        <video
          class="v4-hero__video"
          id="v4-hero-video"
          muted
          playsinline
          preload="auto"
          poster="/videos/hero-portal-poster.jpg"
          aria-hidden="true">
          <source src="/videos/hero-portal.mp4" type="video/mp4" />
        </video>
        <img
          class="v4-hero__poster-img"
          src="/videos/hero-portal-poster.jpg"
          alt=""
          aria-hidden="true"
          data-v4-poster
          hidden
        />
        <div class="v4-hero__vignette" aria-hidden="true"></div>

        <!-- Beat 1: opening — pre-portal -->
        <div class="v4-hero__beat v4-hero__beat--1" data-beat="1">
          <div class="v4-hero__beat-inner">
            <h1 class="v4-h-hero">
              Лучшие клубы Казахстана.<br />
              <span class="v4-secondary">Один тап до игры.</span>
            </h1>
            <div class="v4-hero__cta-stack">
              <a href="#catalog" class="v4-btn v4-btn--primary v4-btn--lg">Найти клуб</a>
            </div>
          </div>
        </div>

        <!-- Beat 3: post-portal — promise -->
        <div class="v4-hero__beat v4-hero__beat--3" data-beat="3">
          <div class="v4-hero__beat-inner">
            <h2 class="v4-h-section">
              Забронируй слот за <span class="v4-mono v4-accent">30</span>&nbsp;секунд.<br />
              <span class="v4-secondary">Без звонков, без очередей.</span>
            </h2>
          </div>
        </div>

        <div class="v4-hero__cue" data-cue>
          <span class="v4-eyebrow">↓ Прокрути ↓</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </div>

        <div class="v4-hero__dots" aria-hidden="true">
          <span class="v4-hero__dot is-active" data-dot="0"></span>
          <span class="v4-hero__dot" data-dot="1"></span>
          <span class="v4-hero__dot" data-dot="2"></span>
        </div>
      </div>
    </section>

    <!-- CATALOG TEASER -->
    <section id="catalog" class="v4-section" aria-label="Каталог клубов">
      <div class="v4-container">
        <div class="v4-catalog__header">
          <span class="v4-eyebrow v4-fade-up">Топ клубы</span>
          <h2 class="v4-h-section v4-fade-up" style="max-width:900px;">Где играть прямо сейчас</h2>
        </div>
        <div class="v4-catalog__grid">
          <article class="v4-card v4-fade-up">
            <div class="v4-card__photo">
              <div class="v4-card__photo-caption">PLACEHOLDER: cyberzone-almaty.jpg</div>
            </div>
            <div class="v4-card__divider"></div>
            <div class="v4-card__body">
              <h3 class="v4-card__title">Cyberzone</h3>
              <p class="v4-card__meta">Алматы · Алмалинский р-н</p>
              <div class="v4-card__rating v4-mono">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/>
                </svg>
                <span class="v4-accent">4.9</span>
                <span class="v4-muted">(412&nbsp;отзывов)</span>
              </div>
              <p class="v4-card__price v4-mono">от <span class="v4-accent">1 500 ₸</span> /час</p>
            </div>
          </article>

          <article class="v4-card v4-fade-up">
            <div class="v4-card__photo">
              <div class="v4-card__photo-caption">PLACEHOLDER: gg-arena-astana.jpg</div>
            </div>
            <div class="v4-card__divider"></div>
            <div class="v4-card__body">
              <h3 class="v4-card__title">GG Arena</h3>
              <p class="v4-card__meta">Астана · Есиль</p>
              <div class="v4-card__rating v4-mono">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/>
                </svg>
                <span class="v4-accent">4.8</span>
                <span class="v4-muted">(287&nbsp;отзывов)</span>
              </div>
              <p class="v4-card__price v4-mono">от <span class="v4-accent">1 800 ₸</span> /час</p>
            </div>
          </article>

          <article class="v4-card v4-fade-up">
            <div class="v4-card__photo">
              <div class="v4-card__photo-caption">PLACEHOLDER: respawn-hub-shym.jpg</div>
            </div>
            <div class="v4-card__divider"></div>
            <div class="v4-card__body">
              <h3 class="v4-card__title">Respawn Hub</h3>
              <p class="v4-card__meta">Шымкент · Аль-Фарабийский</p>
              <div class="v4-card__rating v4-mono">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/>
                </svg>
                <span class="v4-accent">4.7</span>
                <span class="v4-muted">(156&nbsp;отзывов)</span>
              </div>
              <p class="v4-card__price v4-mono">от <span class="v4-accent">1 200 ₸</span> /час</p>
            </div>
          </article>
        </div>

        <div class="v4-catalog__cta-row">
          <a href="/clubs/" class="v4-catalog__all v4-fade-up">
            Все <span class="v4-mono">80+</span> клубов
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="v4-final-cta" aria-label="Готов играть?">
      <div class="v4-bloom" aria-hidden="true"></div>
      <div class="v4-container" style="max-width:1200px;position:relative;">
        <h2 class="v4-h-hero v4-final-cta__h v4-fade-up">Готов играть?</h2>
        <a href="#catalog" class="v4-btn v4-btn--primary v4-btn--lg v4-final-cta__btn v4-fade-up">Найти свой клуб</a>
        <p class="v4-mono v4-final-cta__stats v4-fade-up">
          <span class="v4-accent">12 000+</span> игроков
          &nbsp;·&nbsp;
          <span class="v4-accent">80+</span> клубов
          &nbsp;·&nbsp;
          <span class="v4-accent">10</span> городов
        </p>
      </div>
    </section>
  </main>

  <footer class="v4-footer">
    <div class="v4-container">
      <div class="v4-footer__top-divider"></div>
      <div class="v4-footer__grid">
        <div>
          <div class="v4-footer__col-heading">Каталог</div>
          <ul class="v4-footer__col-list">
            <li><a href="/clubs/?city=Алматы" class="v4-footer__col-link">Алматы</a></li>
            <li><a href="/clubs/?city=Астана" class="v4-footer__col-link">Астана</a></li>
            <li><a href="/clubs/?city=Шымкент" class="v4-footer__col-link">Шымкент</a></li>
            <li><a href="/clubs/" class="v4-footer__col-link">Все города</a></li>
          </ul>
        </div>
        <div>
          <div class="v4-footer__col-heading">Для клубов</div>
          <ul class="v4-footer__col-list">
            <li><a href="/for-clubs/" class="v4-footer__col-link">Подключиться</a></li>
            <li><a href="/for-clubs/#pricing" class="v4-footer__col-link">Тарифы</a></li>
            <li><a href="/for-clubs/#support" class="v4-footer__col-link">Поддержка</a></li>
          </ul>
        </div>
        <div>
          <div class="v4-footer__col-heading">Помощь</div>
          <ul class="v4-footer__col-list">
            <li><a href="/#faq" class="v4-footer__col-link">FAQ</a></li>
            <li><a href="/about/" class="v4-footer__col-link">Контакты</a></li>
            <li><a href="https://t.me/respawn_kz_support" class="v4-footer__col-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 3L2 11l6 2 2 7 4-5 7 5 1-17z"/><path d="M8 13l8-5"/>
              </svg>
              Telegram @respawn_kz_support
            </a></li>
          </ul>
        </div>
        <div>
          <div class="v4-footer__col-heading">Юр.</div>
          <ul class="v4-footer__col-list">
            <li><a href="/privacy/" class="v4-footer__col-link">Политика конфиденциальности</a></li>
            <li><a href="/terms/" class="v4-footer__col-link">Условия использования</a></li>
          </ul>
        </div>
      </div>
      <div class="v4-footer__bottom">
        <span class="v4-logo">respawn.kz</span>
        <span class="v4-footer__copyright v4-mono">© 2026 respawn.kz · Алматы, Казахстан</span>
      </div>
    </div>
  </footer>

  <script>
    // Header scrolled state
    (() => {
      const header = document.getElementById('v4-header');
      if (!header) return;
      const onScroll = () => {
        if (window.scrollY > 80) header.classList.add('is-scrolled');
        else header.classList.remove('is-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();

    // Mobile drawer
    (() => {
      const drawer = document.getElementById('v4-drawer');
      const hamburger = document.getElementById('v4-hamburger');
      if (!drawer || !hamburger) return;
      const open = () => {
        drawer.hidden = false;
        hamburger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        drawer.hidden = true;
        hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      };
      hamburger.addEventListener('click', open);
      drawer.querySelectorAll('[data-drawer-close]').forEach((el) => {
        el.addEventListener('click', close);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) close();
      });
    })();

    // Hero scroll-scrub + beat overlays
    (() => {
      const hero = document.querySelector('[data-v4-hero]');
      if (!hero) return;
      const video = /** @type {HTMLVideoElement|null} */ (document.getElementById('v4-hero-video'));
      const poster = hero.querySelector('[data-v4-poster]');
      const beats = hero.querySelectorAll('[data-beat]');
      const dots = hero.querySelectorAll('[data-dot]');
      const cue = hero.querySelector('[data-cue]');

      const isMobile = window.matchMedia('(max-width: 640px)');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      const setStaticMode = () => {
        if (video) video.style.display = 'none';
        if (poster) poster.removeAttribute('hidden');
        beats.forEach((b) => {
          b.classList.toggle('is-active', b.dataset.beat === '1');
        });
        if (cue) cue.classList.remove('is-active');
        dots.forEach((d, i) => d.classList.toggle('is-active', i === 0));
      };

      const setInteractiveMode = () => {
        if (video) video.style.display = 'block';
        if (poster) poster.setAttribute('hidden', '');
      };

      const onStateChange = () => {
        if (isMobile.matches || reduced.matches) setStaticMode();
        else setInteractiveMode();
      };
      onStateChange();
      isMobile.addEventListener('change', onStateChange);
      reduced.addEventListener('change', onStateChange);

      // Lerp video.currentTime toward target every animation frame.
      // Even when scroll stops, the video keeps easing into its final
      // frame, which removes the "stepping" feel of raw scroll-scrub.
      let targetTime = 0;
      let currentTime = 0;
      let tickActive = false;
      const ease = 0.22; // 0.18-0.30 sweet spot — lower = smoother but laggy

      const tick = () => {
        const diff = targetTime - currentTime;
        if (Math.abs(diff) < 0.004) {
          currentTime = targetTime;
          if (video) { try { video.currentTime = currentTime; } catch (_) {} }
          tickActive = false;
          return;
        }
        currentTime += diff * ease;
        if (video) { try { video.currentTime = currentTime; } catch (_) {} }
        requestAnimationFrame(tick);
      };

      const startTick = () => {
        if (tickActive) return;
        tickActive = true;
        requestAnimationFrame(tick);
      };

      let rafPending = false;
      let lastProgress = -1;
      const update = () => {
        rafPending = false;
        if (isMobile.matches || reduced.matches) return;
        const rect = hero.getBoundingClientRect();
        const total = hero.offsetHeight - window.innerHeight;
        const passed = Math.min(Math.max(-rect.top, 0), total);
        const progress = total > 0 ? passed / total : 0;
        if (Math.abs(progress - lastProgress) < 0.0005) return;
        lastProgress = progress;

        if (video && video.duration && isFinite(video.duration)) {
          targetTime = Math.min(Math.max(progress, 0), 0.9999) * video.duration;
          startTick();
        }

        const beat1Active = progress < 0.33;
        const beat3Active = progress >= 0.66;
        beats.forEach((b) => {
          const which = b.dataset.beat;
          if (which === '1') b.classList.toggle('is-active', beat1Active);
          else if (which === '3') b.classList.toggle('is-active', beat3Active);
        });
        dots.forEach((d, i) => {
          const active =
            (i === 0 && beat1Active) ||
            (i === 1 && !beat1Active && !beat3Active) ||
            (i === 2 && beat3Active);
          d.classList.toggle('is-active', active);
        });
        if (cue) cue.classList.toggle('is-active', beat1Active && progress < 0.15);
      };

      const onScroll = () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      // Initial paint synchronously (rAF is paused on hidden tabs).
      update();
      requestAnimationFrame(update);
    })();

    // Fade-up reveal
    (() => {
      const els = document.querySelectorAll('.v4-fade-up');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      els.forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
